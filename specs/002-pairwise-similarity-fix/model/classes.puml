package "Utility #LightGreen" as UTIL {
  class "NumpyConverter" as NumpyConverter {
    + {static} to_native(obj: Any): Any
    - {static} _convert_value(value: Any): Any
  }
  RF(NumpyConverter)
  note right of NumpyConverter
    util/json_encoder.py (NOVO)
    Percorre dicts/lists recursivamente
    numpy.integer → int
    numpy.floating → float
    numpy.ndarray → list
    numpy.bool_ → bool
  end note

  class "JSONEncoder (stdlib)" as JSONEncoder {
    + default(obj: Any): Any
  }
  RF(JSONEncoder)
  note right of JSONEncoder : json.JSONEncoder base
}

' ============================================================
' PACOTE: Tipos NumPy
' ============================================================

package "NumPy Types (External) #LightPink" as NUMPY {
  class "numpy.int64" as NpInt64 {
    + item(): int
  }
  class "numpy.float64" as NpFloat64 {
    + item(): float
  }
  class "numpy.ndarray" as NpArray {
    + tolist(): list
  }
  class "numpy.bool_" as NpBool {
    + item(): bool
  }
}

